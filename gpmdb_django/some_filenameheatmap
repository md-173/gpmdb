+		function fisherStatistic(data) {
+			let sumX = 0, sumY = 0, sumZ = 0;
+			let N = 0;
+
+			for (let i = 0; i < data.length; i++) {
+				let D = parseFloat(data[i][6]);  // Declination
+				let I = parseFloat(data[i][7]);  // Inclination
+
+				if (isNaN(D) || isNaN(I)) continue;
+
+				let D_rad = D * Math.PI / 180;
+				let I_rad = I * Math.PI / 180;
+
+				sumX += Math.cos(I_rad) * Math.cos(D_rad);
+				sumY += Math.cos(I_rad) * Math.sin(D_rad);
+				sumZ += Math.sin(I_rad);
+				N++;
+			}
+
+			if (N === 0) return null;
+
+			let meanX = sumX / N;
+			let meanY = sumY / N;
+			let meanZ = sumZ / N;
+
+			let k = N / (Math.pow(meanX, 2) + Math.pow(meanY, 2) + Math.pow(meanZ, 2));
+
+			return {
+				N: N,
+				meanDirection: { X: meanX, Y: meanY, Z: meanZ },
+				fisherK: k
+			};
+		}
